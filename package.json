{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Comprehensive Playwright automation framework with TypeScript, supporting UI, API, E2E, and stress testing with Page Object Model pattern",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --project=ui-chromium --project=api --project=e2e",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:stress": "playwright test --project=stress --workers=1",
    "test:headed": "npm test -- --headed",
    "test:debug": "npm test -- --debug",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "demo": "node src/fixtures/demo-server.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "dotenv": "18.0.10",
    "typescript": "5.9.3"
  }
}
